# Flask session encryption key - set to any random string
FLASK_SECRET_KEY=your-secret-key-here

# TMDB API key - get yours at https://www.themoviedb.org/settings/api
TMDB_API_KEY=your-tmdb-api-key-here

# Set to "production" when deploying (enables secure cookies + HSTS)
FLASK_ENV=development

# Who can open /admin (comma-separated, case-insensitive).
# If unset, the first registered user is the admin (legacy behavior).
ADMIN_USERNAME=your-username

# Optional: custom path for the SQLite database file
# For Railway/Render volumes, use: /data/tracker.db
# DATABASE_PATH=/data/tracker.db

# Optional: Google OAuth (leave blank to disable Google sign-in)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
